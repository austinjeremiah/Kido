# dependencies
node_modules/
.pnp
.pnp.js

# next — anchored to the repo root, because "build/" and "out/" unanchored
# match any directory of that name at any depth, and app/projects/[projectId]/
# build is a route
/.next/
/out/
/build/
frontend/.next/
frontend/out/
next-env.d.ts

# env — .env.example is committed, the real ones are not
.env
.env*.local

# typescript
*.tsbuildinfo

# editors and os
.DS_Store
.idea/
.vscode/
*.swp

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
