###############################################################################
### REQUIRED ENVIRONMENT VARIABLES - SENSITIVE INFORMATION                  ###
### Copy this file to `.env` (gitignored) and fill in real values.          ###
### DO NOT UPLOAD OR SHARE `.env` UNDER ANY CIRCUMSTANCES                   ###
###############################################################################
# Ethereum private key or 1Password reference (e.g. op://vault/item/field)
# NOTE: the upstream CRE template ships a literal placeholder key here
# (0x…0001, the well-known "private key = 1"). It is blanked deliberately: an example file should
# never contain a key-shaped value, because it trains both humans and secret scanners to treat
# 64-hex-next-to-PRIVATE_KEY as normal. Names only, per the repository rule.
CRE_ETH_PRIVATE_KEY=
# Default target used when --target is not specified (e.g. staging-settings, production-settings)
CRE_TARGET=staging-settings
# Value behind the API_TOKEN secret in secrets.yaml. The enclave fetches this
# with runtime.getSecret({ id: 'API_TOKEN' }).
SECRET_CONTEXTLOCK_PRIVATE_POLICY=
SECRET_CONTEXTLOCK_RISK_API_TOKEN=
# Sepolia RPC used by the simulator's EVM log trigger. Kept here (gitignored .env) rather than in
# project.yaml, which is tracked and would otherwise carry the provider API key.
CRE_SECRET_RPC_SEPOLIA=
