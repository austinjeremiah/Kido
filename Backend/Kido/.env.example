# Kido — environment variable NAMES ONLY. Never put real values in this file or commit a .env.
# Testnet only. Kido never holds a root controller key.

# ---- chains
SEPOLIA_RPC_URL=              # Ethereum Sepolia RPC (falls back to a public RPC)
SUI_GRPC_URL=                 # Sui testnet gRPC (falls back to fullnode.testnet.sui.io)

# ---- Kido API / CLI (apps/kido)
KIDO_API_HOST=
KIDO_API_PORT=
KIDO_DATA_DIR=                # project store (default .kido/projects)
KIDO_AMANE_MANIFEST=          # Amane deployment manifest (default ../Aname/deployments/testnet.json)
KIDO_INTERVIEW_MODEL=         # rule | openai
KIDO_CONTROLLER_ADDRESSES=    # owner controller ADDRESSES (comma-separated), public only
KIDO_ISSUER_ADDRESS=          # lease issuer ADDRESS
KIDO_AGENT_ADDRESS=           # agent ADDRESS

# ---- models (live-model tier; absent = BLOCKED_ENV, never a silent mock)
OPENAI_API_KEY=
OPENAI_MODEL=
KIDO_MODEL=
KIDO_OPENAI_TRACING=          # 1 to enable SDK tracing

# ---- wallet-driven deployment from the web app
KIDO_ISSUER_KEY=              # Kido's lease issuer key (bounded by the issuer caps the owner signs)
KIDO_SUI_RELAYER_KEY=         # Sui gas relayer for Sui agents (cannot change any signed message)

# ---- operator-run testnet scripts (scripts/*) — gas and disposable demo keys only
FUNDER_PRIVATE_KEY=           # Sepolia gas payer (and demo Aave borrower)
KIDO_OPERATOR_KEY=            # Sepolia gas payer for identity scripts
KIDO_DEMO_KEYS=               # path to a disposable key file OUTSIDE the repo
KIDO_SUI_SIGNER_KEY=          # funded Sui testnet key for Seal scripts
KIDO_XCHAIN_STATE=            # state file of the Amane cross-chain deployment
KIDO_EVM_BALANCE_FLOOR=       # stop before the gas payer drops below this ETH balance
KIDO_RESCUE_TARGET_HF=        # owner's target Aave health factor for the rescue scenario
KIDO_EVIDENCE_DIR=            # where live runs write evidence (default ../.gauntlet/evidence)
KIDO_EVAL_DIR=                # live-eval output
