# ContextLock - environment variable NAMES ONLY. Never put real values here.
# Copy to .env (gitignored) and fill locally. SEPOLIA TESTNET ONLY.

# ---- Network (Sepolia only; scripts assert chainId == 11155111) ----
SEPOLIA_RPC_URL=
SEPOLIA_CHAIN_ID=11155111

# ---- Funder (source of test ETH only; MUST NOT hold any protocol role) ----
FUNDER_PRIVATE_KEY=
FUNDER_ADDRESS=

# ---- Disposable protocol role keys (generated locally by scripts/gen-wallets.sh) ----
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
CAPABILITY_ISSUER_PRIVATE_KEY=
CAPABILITY_ISSUER_ADDRESS=
AGENT_PRIVATE_KEY=
AGENT_ADDRESS=
RELAYER_PRIVATE_KEY=
RELAYER_ADDRESS=

# ---- Local app ----
DATABASE_URL=file:./contextlock.db
BROKER_PORT=8787
WEB_PORT=3000
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_BROKER_URL=http://localhost:8787
LOG_LEVEL=info

# ---- Demo agent LLM (agent is untrusted by design; never give it a role key) ----
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Generated at deploy time; written to deployments/sepolia.json, not here ----
# CONTEXTLOCK_POLICY_REGISTRY_ADDRESS=
# CONTEXTLOCK_AUTH_REGISTRY_ADDRESS=
# CONTEXTLOCK_EXECUTOR_ADDRESS=
# ENS_AGENT_NAME=
# ENS_AGENT_NODE=

# ---- Phase 4 (Chainlink CRE) - NOT IMPLEMENTED YET ----
# CRE_ETH_PRIVATE_KEY=

# ---- Phase 6/7 (Ledger) - NOT IMPLEMENTED YET ----
# WALLET_PASS=      # never commit; inject from OS secret manager at runtime

# The Graph decentralised gateway API key (https://thegraph.com/studio → API keys). Unlocks the
# subgraph adapter and the indexed source in fork snapshots; without it they report UNAVAILABLE (BLK-V2-GRAPH-KEY).
THEGRAPH_API_KEY=
# Preferred: hold it under the Ledger Key Ring instead — `scripts/studio/ring-secret.sh THEGRAPH_API_KEY`
# writes secrets/thegraph-api-key.ring and the backend decrypts through the ring when it needs it.
# Then leave THEGRAPH_API_KEY empty here. Needs WALLET_PASS in the environment at runtime.
# STUDIO_SECRETS=auto|env|ledger-key-ring   (auto: a ring ciphertext wins over the env var)
# STUDIO_RING_KEY=contextlock-studio         (the ring key name every Studio secret is encrypted under)
# LEDGER_WALLET_CLI=                          (path to wallet-cli; defaults to the npm-installed one)

# STUDIO_QUOTAS=off lifts every count-based quota (builds, model requests, simulations, repair loops, cooldowns).
STUDIO_QUOTAS=
