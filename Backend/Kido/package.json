{
  "name": "contextlock",
  "private": true,
  "version": "0.1.0",
  "description": "ContextLock - capability firewall for autonomous finance (ETHOnline 2026, Sepolia only)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/amane-bridge",
    "packages/kido-runtime",
    "packages/kido-agents",
    "packages/protocol",
    "packages/policy",
    "packages/adapters",
    "packages/ens",
    "packages/ledger",
    "packages/studio-blueprint",
    "packages/studio-simulation",
    "packages/studio-templates",
    "packages/studio-adapters",
    "packages/studio-strategy",
    "packages/studio-org",
    "packages/studio-plan",
    "packages/studio-openapi",
    "packages/studio-deploy",
    "packages/studio-orchestrator",
    "packages/studio-events",
    "packages/studio-network",
    "packages/studio-cre-sim",
    "packages/studio-reality",
    "packages/studio-lab",
    "packages/studio-control-plane",
    "packages/studio-runtime",
    "packages/adapter-sdk",
    "packages/bridge",
    "apps/studio",
    "apps/frontend",
    "apps/studio-web",
    "apps/broker",
    "apps/demo-agent",
    "apps/agent-runtime"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test -vv",
    "secret-scan": "bash scripts/secret-scan.sh",
    "test:all": "bash scripts/test-all.sh",
    "test:ledger:hardware": "bash scripts/test-ledger-hardware.sh",
    "canary-scan": "bash scripts/canary-scan.sh",
    "privilege-audit": "bash scripts/privilege-audit.sh",
    "health": "tsx scripts/health-check.ts",
    "demo:allow": "tsx scripts/demo.ts allow",
    "demo:deny": "tsx scripts/demo.ts deny",
    "demo:replay": "tsx scripts/demo.ts replay",
    "demo:mutate": "tsx scripts/demo.ts mutate",
    "demo:ens-revoke": "tsx scripts/demo.ts ens-revoke",
    "demo:cre-private-context": "bash workflows/cre-policy/contextlock-cre/private-context-proof.sh",
    "demo:cre-verdicts": "bash workflows/cre-policy/contextlock-cre/run-scenes.sh",
    "demo:escalate:software": "tsx scripts/demo.ts escalate",
    "demo:all": "tsx scripts/demo.ts all",
    "ui:legacy": "tsx scripts/serve-ui.ts",
    "studio:api": "tsx apps/studio/src/server.ts",
    "frontend": "npm run dev -w @contextlock/frontend",
    "frontend:build": "npm run build -w @contextlock/frontend",
    "frontend:typecheck": "npm run typecheck -w @contextlock/frontend",
    "studio:web:legacy": "npm run dev -w @contextlock/studio-web",
    "studio:image": "bash apps/studio/sandbox-image/build.sh",
    "studio:demo": "tsx scripts/studio/e2e-demo.ts",
    "test:studio": "vitest run packages/studio-blueprint packages/studio-simulation packages/studio-templates packages/studio-adapters packages/studio-strategy packages/studio-org packages/studio-plan packages/studio-openapi packages/studio-deploy packages/studio-orchestrator packages/studio-runtime packages/studio-events packages/studio-network packages/studio-cre-sim packages/studio-control-plane packages/adapter-sdk packages/bridge apps/studio apps/agent-runtime",
    "studio:demo:groupb": "tsx scripts/studio/group-b-demo.ts",
    "studio:demo:attacks": "tsx scripts/studio/group-b-attacks.ts",
    "studio:demo:groupc": "tsx scripts/studio/group-c-demo.ts",
    "studio:demo:groupc:attacks": "tsx scripts/studio/group-c-attacks.ts",
    "studio:demo:groupd:attacks": "tsx scripts/studio/group-d-attacks.ts",
    "studio:verify:ccip": "tsx scripts/studio/verify-ccip-deployments.ts",
    "studio:preflight": "tsx scripts/studio/group-e-preflight.ts",
    "studio:deploy:testnet": "tsx scripts/studio/group-e-deploy.ts",
    "runtime:image": "bash apps/agent-runtime/build-image.sh",
    "runtime:harden-check": "bash scripts/studio/runtime-hardening-check.sh"
  },
  "devDependencies": {
    "@ledgerhq/wallet-cli": "^2.1.0",
    "@types/node": "22.18.11",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
