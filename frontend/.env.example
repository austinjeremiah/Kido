# WalletConnect / Reown project id — get one at https://cloud.reown.com
# Copy this file to .env.local and paste the id below.
# Without it, injected wallets (MetaMask etc.) still work; WalletConnect-based
# wallets stay unavailable and the Deploy page reports that honestly.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# The Kido API (Backend/Kido: `npm run kido:api`). The Next server proxies /api/* to it.
KIDO_API_URL=http://127.0.0.1:4310
